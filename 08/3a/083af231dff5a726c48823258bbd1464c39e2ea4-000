#!/usr/bin/env python3
# 11 October 2026, 03:05 CEST: colour script of the animatic. One tint per shot, picked from the colours measured on
# the reference (analysis/dna-reference.json): the colour with the most weight once very dark and very light colours
# are set aside, weight = share x (0.3 + saturation). Slots take this tint, so every cut reads as a change of colour,
# as in a colour script. Hatch angles alternate from shot to shot for the same reason.
# Run: ~/.venvs/motion-design/bin/python -I Scripts/MakeColorScript.py
import colorsys
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
FALLBACK = "#3a3c42"


def pick(colours):
    best, best_weight = None, 0.0
    for colour in colours:
        r, g, b = (int(colour["hex"][i:i + 2], 16) / 255 for i in (1, 3, 5))
        _, lightness, saturation = colorsys.rgb_to_hls(r, g, b)
        if not 0.12 <= lightness <= 0.85:
            continue
        weight = colour.get("share", 0.0) * (0.3 + saturation)
        if weight > best_weight:
            best, best_weight = colour["hex"], weight
    return best or FALLBACK


def main():
    dna = json.loads((ROOT / "analysis" / "dna-reference.json").read_text(encoding="utf-8"))
    timeline = json.loads((ROOT / "params" / "timeline.json").read_text(encoding="utf-8"))
    shots = {}
    for index, (shot, measured) in enumerate(zip(timeline["shots"], dna["shots"])):
        tint = pick(measured["palette"])  # palette shares are shares of the frame; accents only as a fallback
        shots[shot["id"]] = {"tint": tint if tint != FALLBACK else pick(measured.get("accents", [])),
                             "hatchAngle": "45deg" if index % 2 == 0 else "135deg"}
    out = {"note": "11 October 2026: generated by Scripts/MakeColorScript.py from analysis/dna-reference.json; never edit by hand.",
           "shots": shots}
    (ROOT / "params" / "color-script.json").write_text(json.dumps(out, indent=2) + "\n", encoding="utf-8")
    print("colour script:", " ".join(f"{sid}:{v['tint']}" for sid, v in shots.items()))


if __name__ == "__main__":
    main()
