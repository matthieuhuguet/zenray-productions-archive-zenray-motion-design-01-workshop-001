// 10 October 2026, 23:58 CEST: the one root timeline. Every shot's choreography, its ambient drift and every caption reveal sit on it at absolute times.
// Copied from template/ by Scripts/Cook.mjs; edit the template copy only.
(function () {
  const core = window.ZR;
  const tl = gsap.timeline({ paused: true });
  window.ZR_MAIN_TIMELINE = tl;
  const shotStart = Object.fromEntries(core.timeline.shots.map((shot) => [shot.id, shot.start]));
  const shotLength = Object.fromEntries(core.timeline.shots.map((shot) => [shot.id, shot.end - shot.start]));
  Object.entries(core.choreography).forEach(([shotId, records]) => {
    const base = shotStart[shotId];
    if (base === undefined) throw new Error(`Choreography names unknown shot ${shotId}`);
    records.forEach((record) => core.run(tl, record, base));
  });
  Object.entries(window.ZR_AMBIENT || {}).forEach(([shotId, drift]) => {
    const base = shotStart[shotId];
    if (base === undefined) throw new Error(`Ambient drift names unknown shot ${shotId}`);
    const amount = drift.amplitude;
    const from = { [drift.property]: -amount };
    const to = { [drift.property]: amount, duration: shotLength[shotId], ease: 'none' };
    tl.fromTo(drift.target, from, to, base);
  });
  core.timeline.captions.forEach((caption) => {
    core.reveal(tl, caption, core.one(`#cap-${caption.id}`));
  });
  tl.seek(0);
})();
