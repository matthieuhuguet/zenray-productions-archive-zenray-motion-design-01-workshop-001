// 10 October 2026, 23:58 CEST: shared runtime helpers. Copied from template/ by Scripts/Cook.mjs; edit the template copy only.
// Reads window.ZR_TOKENS, window.ZR_TIMELINE and window.ZR_CHOREO. No Date, no Math.random: renders must be deterministic.
(function () {
  const tokens = window.ZR_TOKENS;
  const motion = tokens.motion;

  // "@group.key" returns the token itself when it is the whole value, or its text inside a longer string.
  const lookup = (path) => path.split('.').reduce((node, key) => node[key], tokens);
  const resolve = (value) => {
    if (typeof value !== 'string' || !value.includes('@')) return value;
    const whole = value.match(/^@([A-Za-z0-9_.]+)$/);
    if (whole) return lookup(whole[1]);
    return value.replace(/@([A-Za-z0-9_.]+)/g, (match, path) => String(lookup(path)));
  };
  const resolveVars = (vars) => {
    if (!vars) return vars;
    return Object.fromEntries(Object.entries(vars).map(([key, value]) => [key, resolve(value)]));
  };
  const one = (selector) => {
    const found = document.querySelector(selector);
    if (!found) throw new Error(`Missing element ${selector}`);
    return found;
  };

  // Centred elements are placed by their top-left corner in CSS, then shifted by GSAP so the transform stays under GSAP.
  gsap.set('[data-center], .caption-line', { xPercent: -50, yPercent: -50 });

  // Seeded generator (mulberry32): the same seed always gives the same QR-like matrix.
  const seeded = (seed) => () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };

  const buildQr = (container) => {
    const size = resolve('@motion.qrModules');
    const random = seeded(resolve('@motion.qrSeed'));
    const finder = 7;
    container.style.gridTemplateColumns = `repeat(${size}, 1fr)`;
    container.style.gridTemplateRows = `repeat(${size}, 1fr)`;
    // Finder squares sit in three corners; they are fixed first, the rest of the matrix comes from the seed.
    const finderCell = (row, col, top, left) => {
      const r = row - top;
      const c = col - left;
      if (r < 0 || c < 0 || r >= finder || c >= finder) return null;
      return r === 0 || r === finder - 1 || c === 0 || c === finder - 1 || (r >= 2 && r <= 4 && c >= 2 && c <= 4);
    };
    for (let row = 0; row < size; row++) {
      for (let col = 0; col < size; col++) {
        const fixed = [finderCell(row, col, 0, 0), finderCell(row, col, 0, size - finder), finderCell(row, col, size - finder, 0)]
          .find((value) => value !== null);
        const randomOn = random() > 0.5;
        const cell = document.createElement('div');
        cell.className = 'qr-module';
        cell.classList.toggle('on', fixed === undefined ? randomOn : fixed);
        container.appendChild(cell);
      }
    }
  };

  const typewriter = (tl, line, at, duration) => {
    const full = line.textContent;
    const state = { count: 0 };
    tl.fromTo(state, { count: 0 }, {
      count: full.length,
      duration,
      ease: 'none',
      onUpdate: () => { line.textContent = full.slice(0, Math.round(state.count)); },
    }, at);
  };

  const sweep = (tl, line, at, duration) => {
    line.style.backgroundImage = `linear-gradient(90deg, ${tokens.color.fg2} 0%, ${tokens.color.fg} 50%, ${tokens.color.fg2} 100%)`;
    line.style.backgroundSize = '300% 100%';
    line.style.backgroundClip = 'text';
    line.style.webkitBackgroundClip = 'text';
    line.style.color = 'transparent';
    line.style.webkitTextFillColor = 'transparent';
    tl.fromTo(line, { backgroundPosition: '100% 0%' }, { backgroundPosition: '0% 0%', duration, ease: motion.easeInOut }, at);
  };

  // Each caption gets one reveal preset, then a shared exit that finishes at its end time.
  // Reveal and exit take a share of the caption's own window, so a short caption keeps a readable hold.
  // 11 October 2026: before this rule, a 0.6 s caption was still fading in when its exit began.
  const reveal = (tl, caption, line) => {
    const at = caption.start;
    const span = caption.end - caption.start;
    const fit = (seconds, share) => Math.min(seconds, span * share);
    const revealLen = fit(motion.revealDur, 0.3);
    const exitLen = fit(motion.exitDur, 0.15);
    switch (caption.reveal) {
      case 'rise':
        tl.fromTo(line, { y: motion.riseDistance, opacity: 0 }, { y: 0, opacity: 1, duration: revealLen, ease: motion.easeOut }, at);
        break;
      case 'fade':
        tl.fromTo(line, { opacity: 0 }, { opacity: 1, duration: fit(motion.fadeDur, 0.3), ease: motion.easeInOut }, at);
        break;
      case 'blur':
        tl.fromTo(line, { opacity: 0, filter: `blur(${motion.blurAmount})` }, { opacity: 1, filter: 'blur(0px)', duration: revealLen, ease: motion.easeOut }, at);
        break;
      case 'wipe':
        tl.fromTo(line, { clipPath: 'inset(0% 100% 0% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: revealLen, ease: motion.easeInOut }, at);
        break;
      case 'sweep':
        sweep(tl, line, at, fit(motion.sweepDur, 0.4));
        break;
      case 'split-left':
        tl.fromTo(line, { x: -motion.splitOffset, opacity: 0 }, { x: 0, opacity: 1, duration: revealLen, ease: motion.easeOut }, at);
        break;
      case 'split-right':
        tl.fromTo(line, { x: motion.splitOffset, opacity: 0 }, { x: 0, opacity: 1, duration: revealLen, ease: motion.easeOut }, at);
        break;
      case 'typewriter':
        typewriter(tl, line, at, span * motion.typeFraction);
        break;
      default:
        throw new Error(`Unknown reveal ${caption.reveal} on ${caption.id}`);
    }
    tl.to(line, { opacity: 0, duration: exitLen, ease: motion.easeInOut }, caption.end - exitLen);
  };

  // One choreography record, placed at base + at. Ops are prefixed with "$".
  const run = (tl, record, base) => {
    const [op] = record;
    if (op === '$set') {
      const [, target, at, vars] = record;
      tl.set(target, resolveVars(vars), base + resolve(at));
      return;
    }
    if (op === '$draw') {
      const [, target, at, dur, ease, direction] = record;
      const element = one(target);
      const length = element.getTotalLength();
      element.style.strokeDasharray = `${length} ${length}`;
      const hidden = direction === 'in' ? length : 0;
      const shown = direction === 'in' ? 0 : length;
      tl.fromTo(element, { strokeDashoffset: hidden }, { strokeDashoffset: shown, duration: resolve(dur), ease: resolve(ease) }, base + resolve(at));
      return;
    }
    if (op === '$ring') {
      const [, target, at, dur, ease, fraction] = record;
      const element = one(target);
      const circumference = 2 * Math.PI * resolve('@device.ringRadius');
      element.style.strokeDasharray = `${circumference} ${circumference}`;
      tl.fromTo(element, { strokeDashoffset: circumference }, { strokeDashoffset: circumference * (1 - fraction), duration: resolve(dur), ease: resolve(ease) }, base + resolve(at));
      return;
    }
    if (op === '$count') {
      const [, target, at, dur, ease, value] = record;
      const node = one(target);
      const state = { value: 0 };
      const format = (number) => String(Math.round(number)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      tl.fromTo(state, { value: 0 }, {
        value,
        duration: resolve(dur),
        ease: resolve(ease),
        onUpdate: () => { node.textContent = format(state.value); },
      }, base + resolve(at));
      return;
    }
    if (op === '$along') {
      const [, pathSelector, dotSelector, at, dur, ease] = record;
      const path = one(pathSelector);
      const dot = one(dotSelector);
      const length = path.getTotalLength();
      const state = { progress: 0 };
      tl.fromTo(state, { progress: 0 }, {
        progress: 1,
        duration: resolve(dur),
        ease: resolve(ease),
        onUpdate: () => {
          const point = path.getPointAtLength(state.progress * length);
          dot.setAttribute('cx', point.x);
          dot.setAttribute('cy', point.y);
        },
      }, base + resolve(at));
      return;
    }
    if (op === '$qr') {
      const [, target, at, dur, ease] = record;
      const container = one(target);
      if (container.children.length === 0) buildQr(container);
      tl.fromTo(Array.from(container.children), { scale: 0, opacity: 0 }, {
        scale: 1,
        opacity: 1,
        duration: resolve(dur),
        ease: resolve(ease),
        stagger: { each: resolve('@motion.qrStagger'), from: 'start' },
      }, base + resolve(at));
      return;
    }
    const [target, at, dur, ease, from, to] = record;
    const position = base + resolve(at);
    const vars = { ...resolveVars(to), duration: resolve(dur), ease: resolve(ease) };
    if (from === null || from === undefined) {
      tl.to(target, vars, position);
    } else {
      tl.fromTo(target, resolveVars(from), vars, position);
    }
  };

  window.ZR = {
    tokens,
    motion,
    timeline: window.ZR_TIMELINE,
    choreography: window.ZR_CHOREO,
    resolve,
    resolveVars,
    one,
    run,
    reveal,
  };
})();
