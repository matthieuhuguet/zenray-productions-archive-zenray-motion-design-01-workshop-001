        ("Mouvement par plan (rang)", fr(checks["motion"]["shot_rank_correlation"], 3), f"au moins {fr(contract['shot_motion_rank_min'], 2)}", checks["motion"]["shot_rank_correlation"] >= contract["shot_motion_rank_min"]),
        ("Coupes franches retrouvées", f"{checks['cuts']['matched']} sur {checks['cuts']['reference_hard_cuts']}", f"au moins {fr(contract['hard_cut_match_min'] * 100, 0)} %", checks["cuts"]["rate"] >= contract["hard_cut_match_min"]),
        ("Légendes lues par l'OCR", f"{checks['captions']['readable']} sur {checks['captions']['captions']}", f"au moins {fr(contract['caption_recall_min'] * 100, 0)} %", checks["captions"]["readable_rate"] >= contract["caption_recall_min"]),
