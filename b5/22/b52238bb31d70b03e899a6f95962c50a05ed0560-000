                           f"<td><img class=\"thumb\" src=\"animatique/secondes/t{n:02d}.jpg\" alt=\"Animatique à {n},5 s\" loading=\"lazy\"></td></tr>"
                           for n, sid, text in second_rows)
    flow_links = "".join(f'<li><a href="{url}">{esc(name)}</a></li>' for name, url in FLOW_SOURCES)
    summary_cards = [
        ("27", "plans, mêmes coupes que la référence"),
