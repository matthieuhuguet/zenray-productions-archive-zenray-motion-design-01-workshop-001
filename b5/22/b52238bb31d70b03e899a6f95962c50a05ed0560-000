            lines.append(f'<tr><td>{esc(name)}</td><td class="num">{esc(value)}</td><td>{esc(limit)}</td><td>{verdict}</td></tr>')
        return "<table><tr><th>Contrôle</th><th>Valeur</th><th>Limite</th><th>Résultat</th></tr>" + "".join(lines) + "</table>"

