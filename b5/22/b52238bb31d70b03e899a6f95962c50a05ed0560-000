    ]
    sv, fv = stem["values"], final["values"]
    sound_rows = [
        ("Effets : événements chronométrés audibles", f"{sv['audible']} sur {sv['events']} ({sv['allEvents']} en tout)", "tous", sv["audible"] == sv["events"]),
        ("Effets : écart maximal au départ", f"{fr(sv['maxGapMs'], 1)} ms", f"au plus {fr(sv['toleranceMs'], 1)} ms, soit une image", sv["maxGapMs"] <= sv["toleranceMs"]),
