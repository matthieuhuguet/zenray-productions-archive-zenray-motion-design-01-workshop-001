#!/usr/bin/env python3
# 11 October 2026, 03:30 CEST: the animatic sheet (storyboard v2): one HTML page and three CSV files, generated from
# params/ (timeline, reading of the reference, assets, camera, colour script), analysis/ (measured camera and sound of the
# reference), verify/ (reports) and the animatic render (one thumbnail per shot and one per second).
# Nothing in the output is written by hand: change the params, then rebuild.
# Run from the atelier: ~/.venvs/motion-design/bin/python -I Scripts/BuildAnimaticSheet.py --render renders/zenray-motion-design-01-animatique-v1.mp4
import argparse
import csv
import html
import json
import re
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
FPS = 60
SOURCES_CHECKED = "11 October 2026"
FLOW_SOURCES = [
    ("Tarifs de l'API Gemini (officiel)", "https://ai.google.dev/gemini-api/docs/pricing"),
    ("Génération vidéo dans l'API Gemini (officiel)", "https://ai.google.dev/gemini-api/docs/video"),
    ("Veo 3 dans l'API Gemini", "https://geekflare.com/news/you-can-now-use-veo-3-in-the-gemini-api"),
    ("Veo 3.1 dans Flow et Vertex", "https://www.etcentric.org/tag/veo-3-1-fast"),
]
KIND_TEXT = {"image": "image", "video": "vidéo", "3d": "3D", "ui": "interface", "music": "musique", "sfx": "effets",
             "font": "police", "text": "texte", "logo": "logo"}
SOUND_TEXT = {"thump": "coup grave", "whoosh": "souffle", "click": "clic", "tick": "tic de légende", "key": "frappe",
              "blip": "bip", "pulse": "impulsion", "ding": "tintement", "chime": "carillon", "impact": "impact", "riser": "montée"}


def load(relative):
    return json.loads((ROOT / relative).read_text(encoding="utf-8"))


def esc(text):
    return html.escape(str(text), quote=True)


def fr(value, digits=2):
    return f"{value:.{digits}f}".replace(".", ",")


def frames(seconds):
    return int(round(seconds * FPS))


def thumbnails(render, shots, out_dir):
    shot_dir = out_dir / "animatique" / "plans"
    second_dir = out_dir / "animatique" / "secondes"
    shot_dir.mkdir(parents=True, exist_ok=True)
    second_dir.mkdir(parents=True, exist_ok=True)
    for shot in shots:
        middle = (shot["start"] + shot["end"]) / 2
        subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", f"{middle:.3f}", "-i", str(render), "-frames:v", "1",
                        "-vf", "scale=640:360:flags=lanczos", "-q:v", "3", str(shot_dir / f"{shot['id']}.jpg")], check=True)
    subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", "0.5", "-i", str(render), "-vf", "fps=1,scale=320:180:flags=lanczos",
                    "-q:v", "4", "-start_number", "0", str(second_dir / "t%02d.jpg")], check=True)


def loudness(render):
    log = subprocess.run(["ffmpeg", "-hide_banner", "-nostats", "-i", str(render), "-map", "0:a:0", "-af", "ebur128=peak=true",
                          "-f", "null", "-"], capture_output=True, text=True).stderr
    summary = log[log.rfind("Summary:"):]
    integrated = re.search(r"I:\s+(-?[\d.]+) LUFS", summary)
    lra = re.search(r"LRA:\s+([\d.]+) LU", summary)
    return (float(integrated.group(1)) if integrated else None, float(lra.group(1)) if lra else None)


def chip(text, tone):
    return f'<span class="chip chip-{tone}">{esc(text)}</span>'


def status_tone(status):
    return {"slot": "slot", "done": "done", "temp": "temp", "todo": "todo"}.get(status, "slot")


def shot_assets(assets, shot_id):
    return [a for a in assets["assets"] if shot_id in (a.get("shots") or []) or (a.get("slot") or {}).get("shot") == shot_id
            or (a.get("inset") or {}).get("shot") == shot_id]


def camera_text(measured, applied):
    if measured["static"]:
        return "Plan fixe (mouvement total inférieur à 12 px).", "Aucun mouvement de caméra."
    parts = [f"recul ou avance {fr(measured['scale'], 3)}", f"déplacement {fr(measured['dx'], 0)} px en x et {fr(measured['dy'], 0)} px en y",
             f"rotation {fr(measured['rotationDeg'], 2)}°", f"courbe {measured['ease']} (écart {fr(measured['easeError'], 3)})"]
    dominant = {"scale": "échelle", "rotation": "rotation", "translation": "translation"}[measured["dominant"]]
    seen = f"Mouvement dominant : {dominant}, {fr(measured['movePx'], 0)} px ; " + ", ".join(parts) + "."
    if not applied:
        return seen, "Mouvement porté par l'animation du sujet (plan exclu de la caméra)."
    start = applied["from"]
    if applied["target"] == "captions":
        return seen, f"Appliqué aux légendes du plan : échelle de {fr(start['scale'], 3)} à 1, courbe {applied['ease']}."
    return seen, (f"Appliqué au plan : départ à l'échelle {fr(start['scale'], 3)}, décalé de {fr(start['x'], 0)} px et {fr(start['y'], 0)} px, "
                  f"tourné de {fr(start['rotation'], 2)}°, puis retour à la composition avec la courbe {applied['ease']}.")


