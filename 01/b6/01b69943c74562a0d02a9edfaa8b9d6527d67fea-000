# ExtractCaptions.py: OCR every sampled frame, then merge repeated lines into caption spans.
# Run with python3 -I: frames come from a downloaded video and are read only as image files by tesseract.
import argparse
import csv
import io
import json
import re
import subprocess
import tempfile
from concurrent.futures import ProcessPoolExecutor
from pathlib import Path

FRAME_WIDTH, FRAME_HEIGHT = 1280, 720


def ocr_lines(job):
    # One tesseract run per frame; the TSV keeps word boxes and confidence values.
    image_path, index, min_conf = job
    with tempfile.TemporaryDirectory() as scratch:
        base = Path(scratch) / "ocr"
        subprocess.run(
            ["tesseract", str(image_path), str(base), "--psm", "11", "tsv"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
        )
        tsv_path = Path(f"{base}.tsv")
        tsv = tsv_path.read_text(encoding="utf-8", errors="replace") if tsv_path.exists() else ""
    lines = {}
    for row in csv.DictReader(io.StringIO(tsv), delimiter="\t", quoting=csv.QUOTE_NONE):
        text = (row.get("text") or "").strip()
        try:
            conf = float(row.get("conf") or -1)
        except ValueError:
            continue
        if not text or conf < min_conf:
            continue
        key = (row["block_num"], row["par_num"], row["line_num"])
        left, top = int(row["left"]), int(row["top"])
        right, bottom = left + int(row["width"]), top + int(row["height"])
        line = lines.setdefault(key, {"words": [], "box": [left, top, right, bottom], "conf": []})
        line["words"].append(text)
        line["conf"].append(conf)
        box = line["box"]
        box[0], box[1] = min(box[0], left), min(box[1], top)
        box[2], box[3] = max(box[2], right), max(box[3], bottom)
    found = []
    for line in lines.values():
        left, top, right, bottom = line["box"]
        found.append({
            "text": " ".join(line["words"]),
            "x": round(left / FRAME_WIDTH, 4), "y": round(top / FRAME_HEIGHT, 4),
            "w": round((right - left) / FRAME_WIDTH, 4), "h": round((bottom - top) / FRAME_HEIGHT, 4),
            "conf": round(sum(line["conf"]) / len(line["conf"]), 1),
        })
    return index, found


def normalise(text):
    return re.sub(r"\s+", " ", re.sub(r"[^a-z0-9 ]", "", text.lower())).strip()


def merge_spans(per_frame, fps):
    # A line seen again within 0.25 s keeps the same span, so one caption gives one timed span.
    spans = []
    for index in sorted(per_frame):
        time = index / fps
        for line in per_frame[index]:
            key = normalise(line["text"])
            if len(key) < 3 or not re.search(r"[a-z]{2}", key):
                continue
            open_span = next((s for s in spans if s["key"] == key and time - s["end"] <= 0.25), None)
            if open_span is None:
                spans.append({
                    "key": key, "text": line["text"], "start": time, "end": time + 1 / fps, "frames": 1,
                    "x": line["x"], "y": line["y"], "w": line["w"], "h": line["h"], "conf": line["conf"],
                })
            else:
                open_span["end"] = time + 1 / fps
                open_span["frames"] += 1
    for span in spans:
        span.pop("key")
        span["start"] = round(span["start"], 3)
        span["end"] = round(span["end"], 3)
    return sorted(spans, key=lambda s: s["start"])


def main():
    parser = argparse.ArgumentParser(description="OCR sampled frames into caption spans.")
    parser.add_argument("frames_dir", type=Path)
    parser.add_argument("--fps", type=float, default=10.0)
    parser.add_argument("--min-conf", type=float, default=60.0)
    parser.add_argument("--workers", type=int, default=16)
    parser.add_argument("--out", type=Path, required=True)
    args = parser.parse_args()
    frames = sorted(args.frames_dir.glob("*.jpg"))
    jobs = [(path, index, args.min_conf) for index, path in enumerate(frames)]
    per_frame = {}
    with ProcessPoolExecutor(max_workers=args.workers) as pool:
        for index, lines in pool.map(ocr_lines, jobs):
            per_frame[index] = lines
    spans = merge_spans(per_frame, args.fps)
    args.out.write_text(json.dumps(spans, indent=1, ensure_ascii=False), encoding="utf-8")
    print(f"frames={len(frames)} spans={len(spans)} out={args.out}")


if __name__ == "__main__":
    main()
