<!doctype html>
<html lang="en" data-resolution="landscape">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <link rel="stylesheet" href="tokens.css" />
    <style>
      @font-face { font-family: 'InterVariable'; src: url('assets/fonts/InterVariable.ttf') format('truetype'); font-weight: 100 900; font-style: normal; }
      @font-face { font-family: 'Vogun'; src: url('assets/fonts/Vogun-Medium.ttf') format('truetype'); font-weight: 500; font-style: normal; }
      @font-face { font-family: 'AnthropicSerif'; src: url('assets/fonts/AnthropicSerif-Regular.ttf') format('truetype'); font-weight: 400; font-style: normal; }
      @font-face { font-family: 'AnthropicMono'; src: url('assets/fonts/AnthropicMono-Regular.ttf') format('truetype'); font-weight: 400; font-style: normal; }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: var(--zr-color-bg); }
      #root { position: relative; width: 1920px; height: 1080px; overflow: hidden; background: var(--zr-color-bg); color: var(--zr-color-fg); font-family: var(--zr-type-sans); }
      .clip { position: absolute; inset: 0; }
      [data-center] { position: absolute; left: 50%; top: 50%; }
      .stage { position: absolute; inset: 0; perspective: var(--zr-device-depth); transform-style: preserve-3d; }
      .full { position: absolute; inset: 0; }
      .svg-full { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; overflow: visible; }

      /* Captions: one full-frame clip per caption; the line sits at --cx and --cy (fractions of the frame). */
      .caption-line { position: absolute; inset: auto; max-width: var(--zr-layout-caption-max-width); left: calc(var(--cx) * 100%); top: calc(var(--cy) * 100%); white-space: nowrap; font-weight: 400; letter-spacing: var(--zr-type-tracking); line-height: 1; }
      .size-title-big { font-size: var(--zr-type-size-title); }
      .size-statement { font-size: var(--zr-type-size-statement); }
      .size-sub { font-size: var(--zr-type-size-sub); }
      .size-title { font-size: var(--zr-type-size-label); }
      .size-small { font-size: var(--zr-type-size-small); }
      .size-footnote { font-size: var(--zr-type-size-footnote); }
      .fill-fg { color: var(--zr-color-fg); }
      .fill-fg2 { color: var(--zr-color-fg2); }
      .fill-fg3 { color: var(--zr-color-fg3); }

      /* Device: metal frame, dark glass screen, timeline UI. */
      .device { width: var(--zr-device-width); height: var(--zr-device-height); border-radius: var(--zr-device-radius); background: linear-gradient(145deg, var(--zr-color-metal-edge) 0%, var(--zr-color-metal-dark) 38%, var(--zr-color-frame) 62%, var(--zr-color-metal-mid) 100%); box-shadow: inset 0 0 0 3px var(--zr-color-rim), 0 60px 120px -40px var(--zr-color-shadow); }
      .device.small { width: var(--zr-device-small); height: var(--zr-device-small-height); }
      .device-screen { position: absolute; inset: 26px; border-radius: 44px; overflow: hidden; background: radial-gradient(circle at 50% 18%, var(--zr-color-screen-glow) 0%, var(--zr-color-screen) 70%); }
      .ui-label { position: absolute; left: 40px; top: 56px; font-family: var(--zr-type-mono); font-size: var(--zr-type-size-mono); color: var(--zr-color-fg2); letter-spacing: 0.04em; }
      .ruler { position: absolute; left: 40px; right: 40px; top: 120px; height: 36px; background: repeating-linear-gradient(90deg, var(--zr-color-glass) 0px, var(--zr-color-glass) 2px, transparent 2px, transparent 48px); }
      .track { position: absolute; left: 40px; right: 40px; height: 56px; border-radius: 28px; background: var(--zr-color-glass); overflow: hidden; }
      .track i { position: absolute; inset: 0; background: linear-gradient(90deg, var(--zr-color-accent), var(--zr-color-accent-deep)); transform-origin: 0% 50%; }
      .track.t1 { top: 220px; }
      .track.t2 { top: 300px; }
      .track.t2 i { background: linear-gradient(90deg, var(--zr-color-signal), var(--zr-color-signal-deep)); }
      .track.t3 { top: 380px; }
      .track.t3 i { background: linear-gradient(90deg, var(--zr-color-bronze-light), var(--zr-color-bronze-mid)); }
      .track.t4 { top: 460px; }
      .track.t4 i { background: linear-gradient(90deg, var(--zr-color-steel), var(--zr-color-screen-glow)); }
      .playhead { position: absolute; left: 40px; top: 190px; width: 4px; height: 340px; border-radius: 2px; background: var(--zr-color-fg); }

      /* Orb, arch, slabs and plates. */
      .orb { width: var(--zr-device-orb); height: var(--zr-device-orb); border-radius: 50%; background: radial-gradient(circle at 42% 36%, var(--zr-color-orb-core) 0%, var(--zr-color-accent) 26%, var(--zr-color-accent-deep) 58%, transparent 72%); filter: blur(var(--zr-effects-halo-blur)); }
      .arch { width: var(--zr-device-arch-width); height: var(--zr-device-arch-height); border-radius: var(--zr-device-arch-radius) var(--zr-device-arch-radius) 0 0; background: linear-gradient(180deg, var(--zr-color-accent) 0%, var(--zr-color-accent-deep) 48%, var(--zr-color-signal-deep) 100%); box-shadow: 0 0 var(--zr-effects-halo-blur) var(--zr-color-accent); }
      .slab { width: var(--zr-device-slab-width); height: var(--zr-device-slab-height); border-radius: var(--zr-device-slab-radius); background: linear-gradient(90deg, var(--zr-color-metal-dark) 0%, var(--zr-color-metal-light) 22%, var(--zr-color-metal-mid) 40%, var(--zr-color-metal-light) 58%, var(--zr-color-metal-dark) 80%, var(--zr-color-frame) 100%); box-shadow: inset 0 0 0 2px var(--zr-color-rim); overflow: hidden; }
      .sheen { position: absolute; top: 0; bottom: 0; left: 0; width: 40%; background: linear-gradient(90deg, transparent 0%, var(--zr-color-glass) 50%, transparent 100%); }
      .connector { position: absolute; left: 50%; top: 50%; width: 360px; height: 160px; margin-left: -180px; margin-top: -80px; border-radius: 80px; background: linear-gradient(180deg, var(--zr-color-metal-light), var(--zr-color-metal-mid)); box-shadow: inset 0 0 0 2px var(--zr-color-rim), 0 30px 60px -20px var(--zr-color-shadow); }
      .connector i { position: absolute; top: 50%; width: 36px; height: 36px; margin-top: -18px; border-radius: 50%; background: var(--zr-color-frame); }
      .connector i:nth-child(1) { left: 40px; }
      .connector i:nth-child(2) { left: 162px; }
      .connector i:nth-child(3) { right: 40px; }
      .bronze { position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 60%, var(--zr-color-bronze-mid) 0%, var(--zr-color-accent-deep) 40%, var(--zr-color-bg) 85%); overflow: hidden; }
      .band { position: absolute; top: 0; bottom: 0; left: 0; width: 45%; background: linear-gradient(100deg, transparent 0%, var(--zr-color-bronze-light) 50%, transparent 100%); }
      .plane { position: absolute; left: 50%; top: 50%; width: 2200px; height: 900px; margin-left: -1100px; margin-top: -450px; border-radius: 40px; background: linear-gradient(160deg, var(--zr-color-accent) 0%, var(--zr-color-accent-deep) 45%, var(--zr-color-bg) 100%); }
      .streak { position: absolute; top: 30%; left: 0; width: 640px; height: 3px; border-radius: 2px; background: linear-gradient(90deg, transparent, var(--zr-color-trail), transparent); }
      #streak-2 { top: 46%; width: 520px; height: 2px; }
      #streak-3 { top: 62%; width: 760px; height: 2px; background: linear-gradient(90deg, transparent, var(--zr-color-trail-warm), transparent); }

      /* Layers, trails and flashes. */
      .layers { position: absolute; left: 50%; top: 50%; width: 1100px; height: 640px; margin-left: -550px; margin-top: -320px; transform-style: preserve-3d; }
      .layer { position: absolute; inset: 0; border-radius: 36px; background: linear-gradient(135deg, var(--zr-color-glass) 0%, var(--zr-color-glass-soft) 100%); box-shadow: inset 0 0 0 2px var(--zr-color-rim); }
      .layer-label { position: absolute; left: 56px; top: 48px; font-size: var(--zr-type-size-footnote); color: var(--zr-color-fg2); }
      .trail { fill: none; stroke: var(--zr-color-trail); stroke-width: 3; stroke-linecap: round; }
      .flash { position: absolute; inset: 0; background: var(--zr-color-fg); opacity: 0; }
      .slice { position: absolute; left: 0; right: 0; height: 90px; background: var(--zr-color-trail); opacity: 0.55; }
      #slice-1 { top: 380px; }
      #slice-2 { top: 640px; background: var(--zr-color-accent); }

      /* Chips, board and confirmation. */
      .chip-grid { position: absolute; left: 50%; top: 50%; width: 760px; height: 760px; margin-left: -380px; margin-top: -380px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
      .chip { position: relative; border-radius: 36px; background: linear-gradient(145deg, var(--zr-color-metal-light) 0%, var(--zr-color-chip-body) 45%, var(--zr-color-frame) 100%); box-shadow: inset 0 0 0 2px var(--zr-color-rim); }
      .chip i { position: absolute; inset: 12px; border-radius: 28px; opacity: 0; box-shadow: inset 0 0 0 3px var(--zr-color-trail), 0 0 40px var(--zr-color-signal); }
      .pcb-bg { background: radial-gradient(ellipse at 50% 50%, var(--zr-color-steel) 0%, var(--zr-color-frame) 45%, var(--zr-color-bg) 100%); }
      .trace { fill: none; stroke: var(--zr-color-trace); stroke-width: 4; stroke-linecap: round; }
      .pcb-chip { fill: var(--zr-color-chip-body); stroke: var(--zr-color-chip-edge); stroke-width: 3; }
      .check-svg { position: absolute; left: 50%; top: 50%; width: 240px; height: 240px; transform: translate(-50%, -50%); }
      #check-path { fill: none; stroke: var(--zr-color-accent); stroke-width: 18; stroke-linecap: round; stroke-linejoin: round; }

      /* Tracker puck, pad with arcs, swipe card. */
      .puck-bg { background: radial-gradient(circle at 50% 50%, var(--zr-color-signal-deep) 0%, var(--zr-color-bg) 75%); }
      .puck { width: 220px; height: 220px; border-radius: 50%; background: radial-gradient(circle at 40% 35%, var(--zr-color-fg) 0%, var(--zr-color-signal) 35%, var(--zr-color-signal-deep) 80%); box-shadow: 0 0 60px var(--zr-color-signal); }
      .ping { width: 220px; height: 220px; border-radius: 50%; box-shadow: inset 0 0 0 4px var(--zr-color-trail); }
      .pad { width: var(--zr-device-pad); height: var(--zr-device-pad-height); border-radius: 48px; background: linear-gradient(180deg, var(--zr-color-pad-top) 0%, var(--zr-color-pad-bottom) 100%); box-shadow: inset 0 0 0 2px var(--zr-color-rim), 0 40px 80px -30px var(--zr-color-shadow); }
      .arc { fill: none; stroke: var(--zr-color-trail); stroke-width: 10; stroke-linecap: round; transform-box: fill-box; transform-origin: 50% 100%; }
      .swipe { position: absolute; inset: 0; }
      .card { width: var(--zr-device-card); height: var(--zr-device-card-height); border-radius: 40px; transform-style: preserve-3d; }
      .card-face { position: absolute; inset: 0; border-radius: 40px; backface-visibility: hidden; }
      .card-face.front { background: linear-gradient(135deg, var(--zr-color-signal) 0%, var(--zr-color-signal-deep) 60%, var(--zr-color-bg) 100%); }
      .card-face.back { background: linear-gradient(135deg, var(--zr-color-accent) 0%, var(--zr-color-accent-deep) 100%); transform: rotateY(180deg); }
      .card-stripe { position: absolute; left: 0; right: 0; top: 90px; height: 64px; background: var(--zr-color-frame); }
      .card-mono { position: absolute; left: 48px; bottom: 44px; font-family: var(--zr-type-mono); font-size: var(--zr-type-size-mono); color: var(--zr-color-fg); letter-spacing: 0.06em; }

      /* Menu, QR matrix and passkey ripples. */
      .menu { position: absolute; left: 40px; right: 40px; top: 120px; list-style: none; }
      .menu-item { height: 96px; line-height: 96px; margin-bottom: 14px; padding-left: 32px; border-radius: 28px; background: var(--zr-color-glass); font-size: var(--zr-type-size-footnote); color: var(--zr-color-fg); }
      .qr-card { width: var(--zr-device-qr-size); height: var(--zr-device-qr-size); padding: 40px; border-radius: 40px; background: var(--zr-color-qr-light); }
      .qr { width: 100%; height: 100%; display: grid; }
      .qr-module { background: transparent; }
      .qr-module.on { background: var(--zr-color-qr-dark); }
      .ripple-bg { background: linear-gradient(160deg, var(--zr-color-steel) 0%, var(--zr-color-signal-deep) 55%, var(--zr-color-bg) 100%); }
      .ripple { width: 520px; height: 520px; border-radius: 50%; border: 6px solid var(--zr-color-trail); }

      /* Five beat swatches cut on the beat, then one flash layer. */
      .beat { position: absolute; inset: 0; opacity: 0; }
      #beat-1 { background: var(--zr-color-accent); }
      #beat-2 { background: var(--zr-color-signal); }
      #beat-3 { background: var(--zr-color-steel); }
      #beat-4 { background: var(--zr-color-bronze-light); }
      #beat-5 { background: var(--zr-color-accent-deep); }

      /* Counter ring, paired panels, licence badge, easing curve. */
      .panel-pair { width: 1200px; height: 760px; }
      .panel { width: 520px; height: 760px; border-radius: 40px; background: linear-gradient(160deg, var(--zr-color-signal-deep) 0%, var(--zr-color-bg) 100%); box-shadow: inset 0 0 0 2px var(--zr-color-rim); }
      .ring-wrap { width: 640px; height: 640px; }
      .ring { position: absolute; left: 0; top: 0; width: 640px; height: 640px; transform: rotate(-90deg); }
      .ring-track { fill: none; stroke: var(--zr-color-glass); stroke-width: var(--zr-device-ring-stroke); }
      .ring-value { fill: none; stroke: var(--zr-color-accent); stroke-width: var(--zr-device-ring-stroke); stroke-linecap: round; }
      .counter { position: absolute; font-family: var(--zr-type-serif); font-weight: 400; font-size: var(--zr-type-size-counter); color: var(--zr-color-fg); line-height: 1; letter-spacing: -0.01em; white-space: nowrap; }
      .counter-label { position: absolute; font-family: var(--zr-type-mono); font-size: var(--zr-type-size-mono); color: var(--zr-color-fg2); white-space: nowrap; }
      #counter-label { top: calc(50% + 120px); }
      .badge { position: absolute; top: 72%; padding: 26px 44px; border-radius: 99px; background: var(--zr-color-glass); font-family: var(--zr-type-mono); font-size: var(--zr-type-size-small); color: var(--zr-color-fg); white-space: nowrap; }
      .ease-wrap { position: absolute; width: 1280px; height: 640px; top: 66%; }
      .ease-wrap svg { position: absolute; inset: 0; width: 100%; height: 100%; }
      .ease-grid { fill: none; stroke: var(--zr-color-glass); stroke-width: 2; }
      .ease-path { fill: none; stroke: var(--zr-color-accent); stroke-width: 6; stroke-linecap: round; }
      .ease-dot { fill: var(--zr-color-fg); }

      /* Smoke display type, floors and the logo mark. */
      .smoke-word { position: absolute; font-family: var(--zr-type-display); font-size: var(--zr-type-size-hero); line-height: 1; letter-spacing: 0.02em; white-space: nowrap; color: transparent; background: linear-gradient(180deg, var(--zr-color-smoke-light) 0%, var(--zr-color-smoke-dark) 100%); -webkit-background-clip: text; background-clip: text; filter: url(#smoke-filter); opacity: 0; }
      .smoke-word.smoke-accent { filter: none; background: linear-gradient(180deg, var(--zr-color-bronze-light) 0%, var(--zr-color-accent-deep) 60%, var(--zr-color-floor-warm) 100%); -webkit-background-clip: text; background-clip: text; }
      .floor { position: absolute; left: 0; right: 0; bottom: 0; height: 360px; background: linear-gradient(180deg, var(--zr-color-floor) 0%, var(--zr-color-bg) 100%); opacity: 0; }
      .floor.warm { background: linear-gradient(180deg, var(--zr-color-floor-warm) 0%, var(--zr-color-bg) 100%); }
      .logo { position: absolute; width: var(--zr-device-logo); height: var(--zr-device-logo); overflow: visible; }
      #logo-ring { fill: none; stroke: var(--zr-color-fg); stroke-width: var(--zr-device-logo-stroke); }
      #logo-bar { fill: none; stroke: var(--zr-color-fg); stroke-width: var(--zr-device-logo-stroke); stroke-linecap: round; }
      .logo-dot { width: 24px; height: 24px; border-radius: 50%; background: var(--zr-color-accent); top: calc(50% - 82px); }
    </style>
  </head>
  <body>
    <!-- Shared smoke filter for the display type: its numbers come from effects tokens. -->
    <svg width="0" height="0" style="position: absolute;" aria-hidden="true">
      <defs>
        <filter id="smoke-filter" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency="{{effects.smokeFrequency}}" numOctaves="{{effects.smokeOctaves}}" seed="{{effects.smokeSeed}}" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="{{effects.smokeScale}}" xChannelSelector="R" yChannelSelector="G" result="displaced" />
          <feGaussianBlur in="displaced" stdDeviation="{{effects.smokeBlur}}" />
        </filter>
      </defs>
    </svg>

    <div id="root" data-composition-id="main" data-start="0" data-duration="68" data-width="1920" data-height="1080">
