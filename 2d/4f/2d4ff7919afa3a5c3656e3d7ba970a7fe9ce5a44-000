        </div>
      </div>
      <svg class="svg-full" viewBox="0 0 1920 1080">
        <path id="trail-1" class="trail" d="M120 860 C 520 700, 900 920, 1800 240" />
        <path id="trail-2" class="trail" d="M160 260 C 640 420, 1100 120, 1780 760" />
      </svg>
      <!-- @end:S11 -->

