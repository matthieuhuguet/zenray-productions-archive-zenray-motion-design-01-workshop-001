      <div class="flash" id="flash"></div>
      <div class="slice" id="slice-1"></div>
      <div class="slice" id="slice-2"></div>
      <!-- @end:S12 -->

      <!-- @shot:S13 -->
      <div class="chip-grid" id="chip-grid">
        <div class="chip"><i></i></div>
        <div class="chip"><i></i></div>
        <div class="chip"><i></i></div>
        <div class="chip"><i></i></div>
