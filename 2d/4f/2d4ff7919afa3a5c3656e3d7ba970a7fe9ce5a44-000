            <div class="track t2"><i></i></div>
            <div class="track t3"><i></i></div>
            <div class="track t4"><i></i></div>
            <div class="playhead" id="playhead"></div>
          </div>
        </div>
      </div>
      <!-- @end:S03 -->

      <!-- @shot:S04 -->
      <!-- @end:S04 -->

      <!-- @shot:S05 -->
      <div class="stage">
        <div class="slab" id="slab-a" data-center><div class="sheen" id="sheen-a"></div></div>
      </div>
      <!-- @end:S05 -->

      <!-- @shot:S06 -->
      <div class="stage">
        <div class="slab" id="slab-b" data-center><div class="sheen" id="sheen-b"></div></div>
      </div>
      <!-- @end:S06 -->

      <!-- @shot:S07 -->
      <div class="stage">
        <div class="slab" id="slab-c" data-center></div>
        <div class="connector" id="connector"><i></i><i></i><i></i></div>
      </div>
      <!-- @end:S07 -->

      <!-- @shot:S08 -->
      <div class="bronze" id="bronze"><div class="band" id="band"></div></div>
      <!-- @end:S08 -->

      <!-- @shot:S09 -->
      <div class="plane" id="plane"></div>
      <!-- @end:S09 -->

      <!-- @shot:S10 -->
      <div class="streak" id="streak-1"></div>
