      <div class="orb" id="orb" data-center></div>
      <!-- @end:S01 -->

      <!-- @shot:S02 -->
      <div class="arch" id="arch" data-center></div>
      <!-- @end:S02 -->

      <!-- @shot:S03 -->
      <div class="stage">
        <div class="device" id="device-main" data-center>
