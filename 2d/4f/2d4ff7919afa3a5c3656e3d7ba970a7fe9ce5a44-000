      <div class="pad" id="pad" data-center></div>
      <svg class="svg-full" viewBox="0 0 1920 1080">
        <path id="arc-1" class="arc" d="M720 380 A 260 260 0 0 1 1200 380" />
        <path id="arc-2" class="arc" d="M640 380 A 360 360 0 0 1 1280 380" />
        <path id="arc-3" class="arc" d="M560 380 A 460 460 0 0 1 1360 380" />
      </svg>
      <!-- @end:S18 -->

      <!-- @shot:S19 -->
      <div class="swipe" id="swipe">
        <div class="stage">
          <div class="card" id="card" data-center>
            <div class="card-face front"><div class="card-stripe"></div><span class="card-mono">PLAIN HTML</span></div>
            <div class="card-face back"></div>
          </div>
        </div>
      </div>
      <!-- @end:S19 -->

      <!-- @shot:S20 -->
      <div class="device" id="device-menu" data-center>
        <div class="device-screen">
          <div class="ui-label">Workspace</div>
          <ul class="menu">
            <li class="menu-item">Preview</li>
            <li class="menu-item">Lint</li>
            <li class="menu-item">Render</li>
            <li class="menu-item">Export</li>
            <li class="menu-item">Assets</li>
            <li class="menu-item">Settings</li>
          </ul>
        </div>
      </div>
      <div class="qr-card" id="qr-card" data-center>
        <div class="qr" id="qr"></div>
      </div>
      <!-- @end:S20 -->

      <!-- @shot:S21 -->
      <div class="full ripple-bg"></div>
