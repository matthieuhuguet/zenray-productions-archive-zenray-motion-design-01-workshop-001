      <!-- @end:S13 -->

      <!-- @shot:S14 -->
      <div class="full pcb-bg"></div>
      <svg class="svg-full" id="pcb" viewBox="0 0 1920 1080">
        <path id="trace-1" class="trace" d="M0 300 H520 L640 420 H1280 L1400 300 H1920" />
        <path id="trace-2" class="trace" d="M0 760 H380 L500 640 H1120 L1240 780 H1920" />
        <rect class="pcb-chip" x="700" y="400" width="520" height="300" rx="28" />
