        ("Coupes franches", f"{checks['cuts']['matched']} sur {checks['cuts']['reference_hard_cuts']} retrouvées ({fr(checks['cuts']['rate'] * 100, 0)} %)", f"au moins {fr(contract['hard_cut_match_min'] * 100, 0)} %", checks["cuts"]["rate"] >= contract["hard_cut_match_min"]),
        ("Lisibilité des légendes (OCR)", f"{checks['captions']['readable']} sur {checks['captions']['captions']} lisibles ({fr(checks['captions']['readable_rate'] * 100, 0)} %)", f"au moins {fr(contract['caption_recall_min'] * 100, 0)} %", checks["captions"]["readable_rate"] >= contract["caption_recall_min"]),
        ("Timing des légendes", f"écart médian {fr(checks['captions']['timing_median_s'], 2)} s", f"au plus {fr(contract['caption_timing_median_s'], 2)} s", (checks["captions"]["timing_median_s"] or 99) <= contract["caption_timing_median_s"]),
