def badge(ok):
    return '<span class="pass">réussi</span>' if ok else '<span class="fail">échoué</span>'


def fr(value, digits=2):
    return f"{value:.{digits}f}".replace(".", ",")


def num(value):
    value = float(value)
    return str(int(value)) if value.is_integer() else fr(value, 2)


def wrap_tables(page):
    # Phone width: each table scrolls inside its own box, so the page itself never scrolls sideways.
    return re.sub(r"</table>", "</table></div>", re.sub(r"<table", '<div class="scroll"><table', page))


def esc(text):
    return html.escape(str(text), quote=True)


def frames_of(seconds):
    return int(round(seconds * FPS))


def lookup(tokens, path):
    node = tokens
    for key in path.split("."):
        node = node[key]
    return node


def resolve(value, tokens):
    if not isinstance(value, str) or "@" not in value:
        return value
    whole = TOKEN_WHOLE.match(value)
    if whole:
        return lookup(tokens, whole.group(1))
    return TOKEN_INLINE.sub(lambda match: str(lookup(tokens, match.group(1))), value)


def resolve_map(mapping, tokens):
    if mapping is None:
        return None
    return {key: resolve(value, tokens) for key, value in mapping.items()}


def value_text(value):
    if isinstance(value, bool):
        return str(value).lower()
    if isinstance(value, (int, float)):
        return num(value)
    return str(value)


def props_text(source, target):
    parts = []
    for key, value in target.items():
        if key == "stagger":
            parts.append(f"décalage de {value_text(value)} s entre éléments")
            continue
        label = PROP_LABELS.get(key, key)
        if source and key in source:
            parts.append(f"{label} de {value_text(source[key])} à {value_text(value)}")
        else:
            parts.append(f"{label} vers {value_text(value)}")
    return ", ".join(parts)


def ease_text(value):
    return EASE_TEXT.get(value, value)


def describe_records(records, base, tokens):
    rows = []
    for record in records:
        op = record[0]
        if op == "$set":
            _, target, at, vars_ = record
            when = base + float(resolve(at, tokens))
            rows.append((when, 0.0, f"{target} : réglage immédiat, {props_text(None, resolve_map(vars_, tokens))}"))
        elif op == "$draw":
            _, target, at, dur, ease, direction = record
            when, duration = base + float(resolve(at, tokens)), float(resolve(dur, tokens))
            sense = "apparition du tracé" if direction == "in" else "effacement du tracé"
            rows.append((when, duration, f"{target} : {sense}, courbe {ease_text(resolve(ease, tokens))}"))
        elif op == "$ring":
            _, target, at, dur, ease, fraction = record
            when, duration = base + float(resolve(at, tokens)), float(resolve(dur, tokens))
            rows.append((when, duration, f"{target} : anneau rempli à {fr(float(fraction) * 100, 0)} % du tour, courbe {ease_text(resolve(ease, tokens))}"))
        elif op == "$count":
            _, target, at, dur, ease, value = record
            when, duration = base + float(resolve(at, tokens)), float(resolve(dur, tokens))
            rows.append((when, duration, f"{target} : compteur de 0 à {num(value)}, courbe {ease_text(resolve(ease, tokens))}"))
        elif op == "$along":
            _, path_selector, dot_selector, at, dur, ease = record
            when, duration = base + float(resolve(at, tokens)), float(resolve(dur, tokens))
            rows.append((when, duration, f"{dot_selector} suit le tracé {path_selector}, courbe {ease_text(resolve(ease, tokens))}"))
        elif op == "$qr":
            _, target, at, dur, ease = record
            when, duration = base + float(resolve(at, tokens)), float(resolve(dur, tokens))
            rows.append((when, duration, f"{target} : assemblage module par module, courbe {ease_text(resolve(ease, tokens))}"))
        else:
            target, at, dur, ease, source, destination = record
            when, duration = base + float(resolve(at, tokens)), float(resolve(dur, tokens))
            text = f"{target} : {props_text(resolve_map(source, tokens), resolve_map(destination, tokens))}, courbe {ease_text(resolve(ease, tokens))}"
            rows.append((when, duration, text))
    rows.sort(key=lambda row: row[0])
    return rows


def keyframe_line(when, duration, text):
    span = f"durée {fr(duration, 2)} s" if duration > 0 else "instantané"
    return f"{fr(when, 2)} s, image {frames_of(when)} : {text}, {span}"


def ambient_text(entry, start, end):
    unit = "degrés" if entry["property"].startswith("rotation") else "px"
    amount = entry["amplitude"]
    return (f"{entry['target']} : dérive {entry['property']} de {num(-amount)} à {num(amount)} {unit} "
            f"sur toute la durée du plan (de {fr(start, 2)} s à {fr(end, 2)} s), sans accélération")


def reveal_text(caption, motion):
    # Same window rule as template/motion-core.js: reveal and exit take a share of the caption's own span.
    kind = caption["reveal"]
    span = caption["end"] - caption["start"]

    def fit(seconds, share):
        return min(seconds, span * share)

    exit_len = fit(motion["exitDur"], 0.15)
    if kind == "rise":
        base, full, share = f"montée de {num(motion['riseDistance'])} px avec fondu", motion["revealDur"], 0.3
    elif kind == "fade":
        base, full, share = REVEAL_TEXT["fade"], motion["fadeDur"], 0.3
    elif kind == "sweep":
        base, full, share = REVEAL_TEXT["sweep"], motion["sweepDur"], 0.4
    elif kind == "typewriter":
        base = REVEAL_TEXT["typewriter"]
        duration = span * motion["typeFraction"]
        return f"{base}, {fr(duration, 2)} s ; sortie de {fr(exit_len, 2)} s avant la fin"
    else:
        base, full, share = REVEAL_TEXT.get(kind, kind), motion["revealDur"], 0.3
    duration = fit(full, share)
    shortened = " (réduite pour tenir dans la fenêtre)" if duration < full else ""
    return f"{base}, {fr(duration, 2)} s{shortened} ; sortie de {fr(exit_len, 2)} s avant la fin"

def caption_position(caption, layout):
    x_key, y_key = PLACEMENT_KEYS[caption["placement"]]
    return float(layout[x_key]) * WIDTH, float(layout[y_key]) * HEIGHT


def caption_size(caption, tokens):
    token = SIZE_TOKEN[caption["size"]]
    return float(tokens["type"][token].replace("px", ""))


def checks_for(timeline, tokens, choreography, notes, template_text, report):
    results = []
    shots = timeline["shots"]
    contiguous = all(abs(shots[i]["start"] - shots[i - 1]["end"]) < 1e-6 for i in range(1, len(shots)))
    results.append(("Plans contigus, sans trou ni recouvrement", contiguous, f"{len(shots)} plans"))
    last_frame = frames_of(shots[-1]["end"])
    results.append(("Durée totale en images", last_frame == TOTAL_FRAMES, f"{last_frame} images sur {TOTAL_FRAMES}"))
    results.append(("Notes présentes pour chaque plan", all(s["id"] in notes for s in shots), f"{sum(1 for s in shots if s['id'] in notes)} sur {len(shots)}"))
    missing_targets = []
    for shot_id, records in choreography.items():
        for record in records:
            if record[0] in ("$set", "$draw", "$ring", "$count", "$qr"):
                targets = [record[1]]
            elif record[0] == "$along":
                targets = [record[1], record[2]]
            else:
                targets = [record[0]]
            for target in targets:
                for name in re.findall(r"#([A-Za-z0-9_-]+)", target):
                    # The cook wraps each shot block in a section whose id is shot-SXX, so that id is generated, not authored.
                    generated = name.startswith("shot-")
                    if not generated and f'id="{name}"' not in template_text:
                        missing_targets.append(name)
                for name in re.findall(r"\.([A-Za-z][A-Za-z0-9_-]*)", target):
                    if not re.search(rf'class="[^"]*\b{re.escape(name)}\b', template_text):
                        missing_targets.append("." + name)
    results.append(("Cibles de la chorégraphie présentes dans le gabarit", not missing_targets,
                    "aucune cible manquante" if not missing_targets else ", ".join(sorted(set(missing_targets)))))
    unresolved = []
    for shot_id, records in choreography.items():
        for record in records:
            for field in record:
                if isinstance(field, str) and "@" in field:
                    try:
                        resolve(field, tokens)
                    except (KeyError, TypeError):
                        unresolved.append(field)
    results.append(("Jetons référencés résolus", not unresolved, "tous résolus" if not unresolved else ", ".join(unresolved)))
    bad_hex = [key for key, value in tokens["color"].items() if not HEX.match(value) and not value.startswith("rgba")]
    results.append(("Couleurs en hexadécimal valide", not bad_hex, "toutes valides" if not bad_hex else ", ".join(bad_hex)))
    bad_captions = [c["id"] for c in timeline["captions"] if not (0 <= c["start"] < c["end"] <= 68.0)]
    results.append(("Légendes dans la durée de la vidéo", not bad_captions, "toutes dans la durée" if not bad_captions else ", ".join(bad_captions)))
    duration = report["checks"]["duration"]["value"]
    results.append(("Durée du rendu mesurée", abs(duration - 68.0) <= 0.1, f"{fr(duration, 3)} s"))
    return results


def timeline_svg(shots, captions, act_colours):
    width, height = 1200, 120
    scale = width / TOTAL_FRAMES
    parts = [f'<svg viewBox="0 0 {width} {height}" width="100%" role="img" aria-label="Chronologie des 27 plans">']
    for number, name, start, end, *_ in ACTS:
        x = frames_of(start) * scale
        w = (frames_of(end) - frames_of(start)) * scale
        parts.append(f'<rect x="{x:.1f}" y="20" width="{w:.1f}" height="16" fill="{act_colours[number - 1]}" opacity="0.35"/>')
        parts.append(f'<text x="{x + 4:.1f}" y="14" font-size="12" fill="#161616">{number} {esc(name)}</text>')
    for shot in shots:
        x = frames_of(shot["start"]) * scale
        w = (frames_of(shot["end"]) - frames_of(shot["start"])) * scale
        parts.append(f'<rect x="{x:.1f}" y="40" width="{max(w - 1, 1):.1f}" height="40" fill="#161616" opacity="0.85"/>')
        parts.append(f'<text x="{x + 2:.1f}" y="96" font-size="10" fill="#161616">{shot["id"][1:]}</text>')
    for caption in captions:
        x = frames_of(caption["start"]) * scale
        parts.append(f'<line x1="{x:.1f}" y1="84" x2="{x:.1f}" y2="104" stroke="#cc7c5e" stroke-width="2"/>')
    parts.append("</svg>")
    return "".join(parts)


def anchor_svg(layout, tokens):
    parts = [f'<svg viewBox="0 0 {WIDTH} {HEIGHT}" width="100%" role="img" aria-label="Grille de cadrage 16:9">',
             f'<rect x="4" y="4" width="{WIDTH - 8}" height="{HEIGHT - 8}" fill="#fafaf8" stroke="#161616" stroke-width="6"/>']
    for fraction in (1 / 3, 0.5, 2 / 3):
        parts.append(f'<line x1="{WIDTH * fraction:.0f}" y1="0" x2="{WIDTH * fraction:.0f}" y2="{HEIGHT}" stroke="#e6e4e1" stroke-width="3"/>')
        parts.append(f'<line x1="0" y1="{HEIGHT * fraction:.0f}" x2="{WIDTH}" y2="{HEIGHT * fraction:.0f}" stroke="#e6e4e1" stroke-width="3"/>')
    anchors = [("centre", "centreX", "centerY"), ("titre", "centreX", "titleY"), ("bas", "centreX", "bottomY"),
               ("note", "centreX", "footnoteY"), ("gauche centre", "centreLeftX", "centerY"),
               ("moitié gauche", "splitLeftX", "centerY"), ("moitié droite", "splitRightX", "centerY"),
               ("petite gauche", "leftSmallX", "leftSmallY"), ("grande gauche", "leftStatementX", "leftStatementY"),
               ("marque", "centreX", "logoWordmarkY"), ("compte", "centreX", "handleY")]
    for label, x_key, y_key in anchors:
        x = float(layout[x_key]) * WIDTH
        y = float(layout[y_key]) * HEIGHT
        parts.append(f'<circle cx="{x:.0f}" cy="{y:.0f}" r="14" fill="#cc7c5e"/>')
        parts.append(f'<text x="{x + 22:.0f}" y="{y + 9:.0f}" font-size="34" fill="#161616">{esc(label)} ({fr(float(layout[x_key]), 3)}, {fr(float(layout[y_key]), 3)})</text>')
    parts.append("</svg>")
    return "".join(parts)


def build_html(context):
    tokens, layout, motion = context["tokens"], context["layout"], context["motion"]
    shots, captions = context["shots"], context["captions"]
    checks, report = context["checks"], context["report"]
    colour_rows = []
    for key, value in tokens["color"].items():
        colour_rows.append(f"<tr><td class=\"mono\">{esc(key)}</td><td class=\"mono\">{esc(value)}</td>"
                           f"<td><span class=\"chip\" style=\"background:{esc(value)}\"></span></td></tr>")
    type_rows = []
    for key in ("sizeHero", "sizeCounter", "sizeTitle", "sizeStatement", "sizeSub", "sizeLabel", "sizeSmall", "sizeFootnote", "sizeMono"):
        type_rows.append(f"<tr><td class=\"mono\">{esc(key)}</td><td class=\"num\">{esc(tokens['type'][key])}</td></tr>")
    motion_rows = []
    for key in ("durFast", "durBase", "durSlow", "revealDur", "fadeDur", "exitDur", "sweepDur"):
        motion_rows.append(f"<tr><td class=\"mono\">{esc(key)}</td><td class=\"num\">{fr(motion[key], 2)} s</td>"
                           f"<td class=\"num\">{frames_of(motion[key])} images</td></tr>")
    act_rows = []
    for number, name, start, end, reference_text, study_text, message in ACTS:
        act_rows.append(f"<tr><td class=\"num\">{number}</td><td>{esc(name)}</td>"
                        f"<td class=\"num\">{fr(start, 2)} à {fr(end, 2)} s<br>images {frames_of(start)} à {frames_of(end)}</td>"
                        f"<td>{esc(reference_text)}</td><td>{esc(study_text)}</td><td>{esc(message)}</td></tr>")
    shot_cards = []
    for row in shots:
        keyframes = "".join(f"<li>{esc(line)}</li>" for line in row["keyframes"]) or "<li>Aucun mouvement propre : le plan repose sur ses entrées et sa dérive.</li>"
        captions_here = "".join(f"<li>« {esc(c['text'])} » : {esc(c['window'])}</li>" for c in row["captions"]) or "<li>Aucune légende sur ce plan.</li>"
        ratio = "n.d." if row["ratio"] is None else fr(row["ratio"], 2)
        detected = "non" if row["detected"] is None else f"oui, score {fr(row['detected'], 1)}"
        cut_ref = row["cut_ref"]
        drift = esc(row["drift"]) if row["drift"] else "Aucune dérive propre."
        shot_cards.append(f"""
<article class="shot" id="{row['id']}">
<header><span class="mono">{row['id']}</span><h3>{esc(row['name'])}</h3>
<span class="num">{fr(row['start'], 2)} à {fr(row['end'], 2)} s · images {row['f0']} à {row['f1']} · {row['frames']} images</span></header>
<div class="grid2">
<figure><img src="ours/{row['id']}.png" alt="Rendu {row['id']} à mi-plan"><figcaption>Rendu de l'étude, image au milieu du plan.</figcaption></figure>
<div>
<p><strong>Coupe d'entrée.</strong> {esc(cut_ref)}</p>
<p><strong>Référence, description.</strong> {esc(row['ref_frame'])} <em>Mouvement : {esc(row['ref_motion'])}</em></p>
<p><strong>Étude, description.</strong> {esc(row['study_frame'])}</p>
<p><strong>Cadrage.</strong> {esc(row['framing'])} Caméra : {esc(row['camera'])}. Technique : {esc(row['technique'])}.</p>
<p><strong>Mouvements, dans l'ordre.</strong></p><ul class="kf">{keyframes}</ul>
<p><strong>Dérive continue.</strong> {drift}</p>
<p><strong>Légendes.</strong></p><ul>{captions_here}</ul>
<table class="mini">
<tr><th>Énergie de mouvement</th><th>Référence</th><th>Étude</th><th>Rapport</th><th>Coupe détectée dans le rendu</th></tr>
<tr><td>Moyenne par image</td><td class="num">{row['ref_motion_mean']:.4f}</td><td class="num">{row['ours_motion_mean']:.4f}</td><td class="num">{ratio}</td><td>{detected}</td></tr>
</table>
<p class="cue"><strong>Son du film.</strong> {esc(row['cue'])}</p>
</div></div></article>""")
    caption_rows = []
    for c in captions:
        ocr = "non mesuré" if c["recall"] is None else f"{fr(c['recall'] * 100, 0)} %"
        timing = "non lue par l'OCR" if c["timing"] is None else f"{fr(c['timing'], 2)} s"
        caption_rows.append(
            f"<tr><td class=\"mono\">{c['id']}</td><td class=\"num\">{fr(c['start'], 2)} à {fr(c['end'], 2)} s<br>images {c['f0']} à {c['f1']}</td>"
