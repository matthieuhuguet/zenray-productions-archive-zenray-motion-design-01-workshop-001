def fr(value, digits=2):
    # French decimal comma for every number shown to Matthieu.
    return f"{value:.{digits}f}".replace(".", ",")


def esc(text):
    return html.escape(str(text), quote=True)


def time_range(start, end):
    return f"<span class=\"num\">{fr(start, 2)}&nbsp;à&nbsp;{fr(end, 2)}</span>"


def reference_thumbnails(frames_dir, last_index, shots, out_dir):
    # Reference thumbnails, kept in scratch: they are third-party frames, used for private comparison only.
    out_dir.mkdir(parents=True, exist_ok=True)
    paths = {}
    for shot in shots:
        mid = (shot["start"] + shot["end"]) / 2
        index = min(max(round(mid * 10), 0), last_index)
        image = Image.open(frames_dir / f"f{index:04d}.jpg").convert("RGB").resize((480, 270), Image.Resampling.LANCZOS)
        target = out_dir / f"{shot['id']}.jpg"
        image.save(target, quality=85)
        paths[shot["id"]] = target
    return paths


def swatch(hex_value, label=None):
    label_html = f'<div class="mono">{esc(label)}</div>' if label else ""
    return f'<div class="sw"><span style="background:{esc(hex_value)}"></span><code>{esc(hex_value)}</code>{label_html}</div>'


def top_colours(entries, limit):
    weight = {}
    for entry in entries:
        for colour in entry["colours"]:
            weight[colour["hex"]] = weight.get(colour["hex"], 0.0) + entry["duration"] * colour["share"]
    return [hex_value for hex_value, _ in sorted(weight.items(), key=lambda kv: kv[1], reverse=True)[:limit]]


