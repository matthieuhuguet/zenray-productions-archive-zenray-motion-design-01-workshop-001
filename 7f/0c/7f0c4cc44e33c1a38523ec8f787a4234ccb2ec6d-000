def main():
    parser = argparse.ArgumentParser(description="Build the detailed study storyboard.")
    parser.add_argument("--params", type=Path, required=True)
    parser.add_argument("--template", type=Path, required=True)
    parser.add_argument("--analysis", type=Path, required=True)
    parser.add_argument("--render", type=Path, required=True)
    parser.add_argument("--verify-work", type=Path, required=True)
    parser.add_argument("--report", type=Path, required=True)
    parser.add_argument("--ours-dir", type=Path, required=True)
    parser.add_argument("--out-dir", type=Path, required=True)
    args = parser.parse_args()
    sound_cuts = json.loads((args.params / "sound.json").read_text(encoding="utf-8"))["cuts"]

    timeline = json.loads((args.params / "timeline.json").read_text(encoding="utf-8"))
    tokens = json.loads((args.params / "tokens.json").read_text(encoding="utf-8"))
    ambient = json.loads((args.params / "ambient.json").read_text(encoding="utf-8"))
    choreography = json.loads((args.params / "choreography.json").read_text(encoding="utf-8"))
    notes = json.loads((args.params / "storyboard-notes.json").read_text(encoding="utf-8"))
    dna = json.loads((args.analysis / "dna-reference.json").read_text(encoding="utf-8"))
    report = json.loads(args.report.read_text(encoding="utf-8"))
    template_text = args.template.read_text(encoding="utf-8")
    motion = tokens["motion"]
    layout = tokens["layout"]

    _, ours_motion = curves(args.render, FPS)
    scores = boundary_scores(args.verify_work / "scdet.log")
    spans = ocr_spans(args.verify_work / "frames10", 10)
    ocr = {row["id"]: row for row in caption_checks(timeline, spans)}

    shots = []
    for index, shot in enumerate(timeline["shots"]):
        reference = dna["shots"][index]
        f0, f1 = frames_of(shot["start"]), frames_of(shot["end"])
        window = ours_motion[f0:f1]
        ours_mean = sum(window) / len(window) if window else 0.0
        ref_mean = reference["motion_mean"]
        near = [s for t, s in scores if abs(t - shot["start"]) <= 0.10] if shot["start"] > 0 else []
        detected = max(near) if near else None
        note = notes[shot["id"]]
        keyframes = [keyframe_line(when, duration, text) for when, duration, text in describe_records(choreography.get(shot["id"], []), shot["start"], tokens)]
        drift_entry = ambient.get(shot["id"])
        drift = ambient_text(drift_entry, shot["start"], shot["end"]) if drift_entry else None
        boundary = reference.get("boundary_score")
        if shot["start"] == 0:
            cut_ref = "Début de la vidéo."
        elif boundary is None:
            cut_ref = "Coupe sans score mesurable."
        elif boundary >= 15:
            cut_ref = f"Coupe franche sur la référence (score {fr(boundary, 1)}, image {frames_of(shot['start'])})."
        else:
            cut_ref = f"Coupe douce sur la référence (score {fr(boundary, 1)}, image {frames_of(shot['start'])})."
        cue = f"Coupe à {fr(shot['start'], 2)} s (image {f0}). " + SOUND_CUE[sound_cuts.get(shot["id"], "none")]
        plan_captions = []
        for caption in timeline["captions"]:
            if shot["start"] <= caption["start"] < shot["end"]:
                plan_captions.append({
                    "text": caption["text"], "window": f"{fr(caption['start'], 2)} à {fr(caption['end'], 2)} s, {reveal_text(caption, motion)}",
                })
        shots.append({
            "id": shot["id"], "name": shot["name"], "start": shot["start"], "end": shot["end"],
            "f0": f0, "f1": f1, "frames": f1 - f0, "technique": note["technique_fr"], "camera": CAMERA_FR.get(shot["camera"], shot["camera"]),
            "ref_frame": note["reference_frame"], "ref_motion": note["reference_motion"],
            "study_frame": note["study_frame"], "framing": note["framing"],
            "keyframes": keyframes, "drift": drift, "captions": plan_captions, "cut_ref": cut_ref,
            "cue": cue, "ref_motion_mean": ref_mean, "ours_motion_mean": ours_mean,
            "ratio": (ours_mean / ref_mean) if ref_mean else None, "detected": detected,
        })

    caption_rows = []
    for caption in timeline["captions"]:
        x, y = caption_position(caption, layout)
        row = ocr.get(caption["id"], {})
        fill_token = caption["fill"]
        caption_rows.append({
            "id": caption["id"], "text": caption["text"], "start": caption["start"], "end": caption["end"],
            "f0": frames_of(caption["start"]), "f1": frames_of(caption["end"]),
            "placement_text": PLACEMENT_TEXT[caption["placement"]], "x": x, "y": y,
            "size": caption_size(caption, tokens), "fill_name": fill_token,
            "fill_hex": tokens["color"][fill_token], "reveal": reveal_text(caption, motion),
            "recall": row.get("recall"), "timing": row.get("timing_error"),
        })

    checks = checks_for(timeline, tokens, choreography, notes, template_text, report)
    sound_path = args.report.parent / "sound-report.json"
    sound_report = json.loads(sound_path.read_text(encoding="utf-8")) if sound_path.exists() else None
    visual_path = args.params / "visual-checks.json"
    visual = json.loads(visual_path.read_text(encoding="utf-8")) if visual_path.exists() else {"render": None, "checked": {}}
    if visual.get("render") != args.render.name:
        visual = {"render": args.render.name, "checked": {}}  # a visual check made on another render never counts
    context = {"tokens": tokens, "layout": layout, "motion": motion, "shots": shots,
               "captions": caption_rows, "checks": checks, "report": report, "visual": visual, "sound_report": sound_report}
    args.out_dir.mkdir(parents=True, exist_ok=True)
    (args.out_dir / "storyboard.html").write_text(wrap_tables(build_html(context)), encoding="utf-8")

    with (args.out_dir / "shot-list.csv").open("w", newline="", encoding="utf-8-sig") as handle:
        writer = csv.writer(handle, delimiter=";")
        writer.writerow(["plan", "nom", "début_s", "fin_s", "début_image", "fin_image", "durée_images", "coupe_référence",
                         "énergie_référence", "énergie_étude", "rapport", "coupe_détectée_rendu", "dérive"])
        for row in shots:
            writer.writerow([row["id"], row["name"], fr(row["start"], 2), fr(row["end"], 2), row["f0"], row["f1"], row["frames"],
                             row["cut_ref"], f"{row['ref_motion_mean']:.4f}".replace(".", ","), f"{row['ours_motion_mean']:.4f}".replace(".", ","),
                             "" if row["ratio"] is None else fr(row["ratio"], 2),
                             "" if row["detected"] is None else fr(row["detected"], 1), row["drift"] or ""])
    with (args.out_dir / "caption-list.csv").open("w", newline="", encoding="utf-8-sig") as handle:
        writer = csv.writer(handle, delimiter=";")
        writer.writerow(["légende", "début_s", "fin_s", "début_image", "fin_image", "texte", "x_px", "y_px", "taille_px",
                         "remplissage", "apparition", "lisibilité_ocr", "écart_début_s"])
        for c in caption_rows:
            writer.writerow([c["id"], fr(c["start"], 2), fr(c["end"], 2), c["f0"], c["f1"], c["text"], fr(c["x"], 0), fr(c["y"], 0),
                             fr(c["size"], 0), c["fill_name"] + " " + c["fill_hex"], c["reveal"],
                             "" if c["recall"] is None else fr(c["recall"], 2),
                             "" if c["timing"] is None else fr(c["timing"], 2)])
    (args.out_dir / "checks.json").write_text(json.dumps([{"contrôle": n, "réussi": ok, "détail": d} for n, ok, d in checks],
                                                         indent=2, ensure_ascii=False), encoding="utf-8")
    failed = [name for name, ok, _ in checks if not ok]
    print(f"storyboard: {len(shots)} plans, {len(caption_rows)} légendes, contrôles échoués : {failed or 'aucun'}")


if __name__ == "__main__":
    main()
