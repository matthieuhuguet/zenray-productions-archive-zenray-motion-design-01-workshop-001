            f"<td>{esc(c['reveal'])}</td><td class=\"num\">{ocr}</td><td class=\"num\">{timing}</td></tr>")
    # Captions the OCR does not read in full are listed, and only a visual check recorded for this render counts as read.
    unread = [c["id"] for c in captions if c["recall"] is None or c["recall"] < report["contract"]["caption_recall_min"]]
