    verify = report["checks"]
    verify_rows = [
        ("Durée du rendu", f"{fr(verify['duration']['value'], 3)} s", "68,053 s ± 0,10 s", verify["duration"]["pass"]),
        ("Mouvement image à image", fr(verify["motion"]["frame_correlation"], 3), f"au moins {fr(contract['motion_correlation_min'], 2)}", verify["motion"]["frame_correlation"] >= contract["motion_correlation_min"]),
        ("Mouvement par plan (rang)", fr(verify["motion"]["shot_rank_correlation"], 3), f"au moins {fr(contract['shot_motion_rank_min'], 2)}", verify["motion"]["shot_rank_correlation"] >= contract["shot_motion_rank_min"]),
        ("Coupes franches retrouvées", f"{verify['cuts']['matched']} sur {verify['cuts']['reference_hard_cuts']}", f"au moins {fr(contract['hard_cut_match_min'] * 100, 0)} %", verify["cuts"]["rate"] >= contract["hard_cut_match_min"]),
        ("Légendes lisibles à l'OCR", f"{verify['captions']['readable']} sur {verify['captions']['captions']}", f"au moins {fr(contract['caption_recall_min'] * 100, 0)} %", verify["captions"]["readable_rate"] >= contract["caption_recall_min"]),
        ("Timing des légendes (médiane)", f"{fr(verify['captions']['timing_median_s'], 2)} s", f"au plus {fr(contract['caption_timing_median_s'], 2)} s", (verify["captions"]["timing_median_s"] or 99) <= contract["caption_timing_median_s"]),
        ("Couleurs par plan (ΔE médian)", fr(verify["palette"]["median_delta_e"], 2), f"au plus {fr(contract['palette_delta_e_median_max'], 0)}", verify["palette"]["pass"]),
        ("Taille d'encre des légendes", fr(verify["typography"]["ratio"], 3), f"entre {fr(contract['ink_ratio_min'], 2)} et {fr(contract['ink_ratio_max'], 2)}", verify["typography"]["pass"]),
    ]
    sound_report = context.get("sound_report")
    if sound_report:
        values = sound_report["values"]
        duration_s = verify["duration"]["value"]
        verify_rows += [
            ("Son : format", f"{str(values['codec']).upper()}, {values['channels']} voies, {values['sampleRate'] // 1000} {values['sampleRate'] % 1000:03d} Hz", "AAC, stéréo, 48 000 Hz", values["codec"] == "aac" and values["channels"] == 2 and values["sampleRate"] == 48000),
