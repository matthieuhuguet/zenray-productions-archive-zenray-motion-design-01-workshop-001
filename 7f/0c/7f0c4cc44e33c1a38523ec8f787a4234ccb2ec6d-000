    if seen_ok:
        caption_note += "<p>Relues à l'œil sur l'image de leur instant dans le rendu : " + ", ".join(f"{i} ({checked[i]})" for i in seen_ok) + ".</p>"
    if todo:
        caption_note += f"<p>À contrôler à l'œil avant toute conclusion : {', '.join(todo)}.</p>"
