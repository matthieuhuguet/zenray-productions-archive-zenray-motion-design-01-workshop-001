            f"<td>{esc(kind)}</td>"
            f"<td class=\"num\">{reference['motion_mean']:.4f}</td>"
            f"<td class=\"num\">{ours_motion[shot['id']]:.4f}</td>"
            f"<td>{esc(shot['technique'])}<br><span class=\"mono\">{esc(drift_text)}</span></td>"
            f"<td class=\"thumbs\"><img src=\"{esc(thumbs[shot['id']].as_uri())}\" alt=\"référence {shot['id']}\">"
            f"<img src=\"ours/{shot['id']}.png\" alt=\"rendu {shot['id']}\"></td></tr>"
        )

    rows_captions = []
    for caption in timeline["captions"]:
        rows_captions.append(
            f"<tr><td class=\"mono\">{caption['id']}</td><td>{time_range(caption['start'], caption['end'])}</td>"
            f"<td>{esc(caption['text'])}</td><td class=\"mono\">{esc(caption['placement'])}</td>"
            f"<td class=\"mono\">{esc(caption['size'])}</td><td class=\"mono\">{esc(caption['fill'])}</td>"
            f"<td class=\"mono\">{esc(caption['reveal'])}</td></tr>"
        )

    rows_acts = []
    for number, name, start, end, reference_text, our_text, message in ACTS:
