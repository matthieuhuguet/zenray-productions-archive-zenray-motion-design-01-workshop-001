            ("Son : image inchangée", "identique" if values["pictureIdentical"] else "différente", "identique à la vidéo muette v6", bool(values["pictureIdentical"])),
        ]
    verify_html = "".join(
        f"<tr><td>{esc(name)}</td><td class=\"num\">{esc(value)}</td><td>{esc(limit)}</td>"
        f"<td>{badge(ok)}</td></tr>"
        for name, value, limit, ok in verify_rows)
    overall = "OVERALL PASS" if report["passed"] else "OVERALL FAIL"
    act_colours = [tokens["color"][token] for token in ACT_COLOUR_TOKEN]
    grid_svg = anchor_svg(layout, tokens)
    timeline = timeline_svg(shots, captions, act_colours)
    neutral_reference = ["#000000", "#ffffff", "#d8d8d8", "#b6b4b1"]
    accent_reference = ["#8b3b16", "#a34028", "#e0873f", "#4d74bc", "#0d298d", "#516374"]
    ref_swatches = "".join(f"<span class=\"sw\"><i style=\"background:{c}\"></i><code>{c}</code></span>" for c in neutral_reference + accent_reference)
