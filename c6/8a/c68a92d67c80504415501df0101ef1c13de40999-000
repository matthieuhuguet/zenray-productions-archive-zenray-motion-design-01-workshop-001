#!/usr/bin/env python3
# 11 October 2026, 02:00 CEST: turn the measured camera moves into animation parameters for the animatic.
# Each measured move is inverted so the shot ends on its designed layout: it starts scaled, shifted and
# rotated by the inverse of the measured change, then settles with the measured ease.
# Rules (shots to skip, shots whose move belongs to the captions) live in params/camera-rules.json.
# Run: ~/.venvs/motion-design/bin/python -I Scripts/MakeCamera.py --measured analysis/camera.json
import argparse
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description="Write params/camera.json from measured shot motion.")
    parser.add_argument("--measured", type=Path, required=True)
    args = parser.parse_args()

    measured = json.loads(args.measured.read_text(encoding="utf-8"))["shots"]
    rules = json.loads((ROOT / "params" / "camera-rules.json").read_text(encoding="utf-8"))
    bound = rules["maxScaleFrom"]
    moves = {}
    for shot_id, move in measured.items():
        if move["static"] or shot_id in rules["skip"]:
            continue
        target = "captions" if shot_id in rules["captions"] else "content"
        scale_from = min(bound, max(1 / bound, 1 / move["scale"]))
        entry = {"target": target, "ease": move["ease"], "from": {"scale": round(scale_from, 4)}}
        if target == "content":
            entry["from"].update({"x": round(-move["dx"], 1), "y": round(-move["dy"], 1),
                                  "rotation": round(-move["rotationDeg"], 2)})
        entry["measured"] = {key: move[key] for key in ("scale", "dx", "dy", "rotationDeg", "dominant", "movePx", "easeError")}
        moves[shot_id] = entry
    out = {"note": "11 October 2026: generated by Scripts/MakeCamera.py from the measured moves; edit params/camera-rules.json, never this file.",
           "moves": moves}
    (ROOT / "params" / "camera.json").write_text(json.dumps(out, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    content = sum(1 for entry in moves.values() if entry["target"] == "content")
    print(f"camera: {len(moves)} moves ({content} on shot content, {len(moves) - content} on captions)")


if __name__ == "__main__":
    main()
